# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจริง
# .env.local ถูก .gitignore ตัดอยู่แล้ว — ห้าม commit
# ห้ามใส่รหัสผ่านในไฟล์นี้ทุกกรณี

# ---- Supabase ----
# Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ใช้เฉพาะฝั่ง server (สคริปต์ seed / admin-create / export-snapshot)
# ห้ามใส่ NEXT_PUBLIC_ นำหน้า และห้ามใช้ในโค้ดฝั่ง client
SUPABASE_SERVICE_ROLE_KEY=
